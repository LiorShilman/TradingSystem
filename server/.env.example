# Copy to .env (or run `npm run gen:admin-key` from the repo root, which creates it).
# .env is git-ignored. Never commit real values.
ADMIN_KEY=
PORT=4100
FIREBASE_PROJECT_ID=trading-system-c6921
FIREBASE_SERVICE_ACCOUNT=./firebase-service-account.json
DATA_DIR=./data
# FXCMgr (local ForexConnect bridge) — defaults for the connect form
FXCMGR_URL=http://localhost:11000
FXCMGR_HOST=
